{
  "agent": {
    "metrics_collection_interval": 60,
    "region": "us-east-1",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log",
    "debug": false,
    "omit_hostname": true,
    "usage_data": false
  },
  "metrics": {
    "namespace": "Lab26/CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "metrics_collection_interval": 60,
        "drop_device": true
      }
    },
    "force_flush_interval": 60
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/lab26/application.log",
            "log_group_name": "/cloud-infrastructure-operations-lab/lab26/application",
            "log_stream_name": "{instance_id}",
            "timestamp_format": "%Y-%m-%dT%H:%M:%SZ",
            "timezone": "UTC",
            "encoding": "utf-8"
          }
        ]
      }
    },
    "force_flush_interval": 5
  }
}
