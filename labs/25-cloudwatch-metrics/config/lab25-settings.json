        "PeriodSeconds": 300
      },
      {
        "MetricName": "NetworkOut",
        "Statistics": ["Sum"],
        "PeriodSeconds": 300
      },
      {
        "MetricName": "StatusCheckFailed",
        "Statistics": ["Maximum"],
        "PeriodSeconds": 60
      }
    ]
  }
