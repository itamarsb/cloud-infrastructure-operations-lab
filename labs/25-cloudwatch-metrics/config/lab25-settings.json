{
  "ExpectedAccountId": "412381774441",
  "Region": "us-east-1",
  "AvailabilityZone": "us-east-1a",
  "AmiParameter": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64",
  "InstanceType": "t3.micro",
  "CpuCredits": "standard",
  "RootVolumeSizeGiB": 8,
  "VpcCidr": "10.25.0.0/16",
  "SubnetCidr": "10.25.1.0/24",
  "Names": {
    "Vpc": "lab25-cloudwatch-vpc",
    "Subnet": "lab25-cloudwatch-public-subnet-a",
    "InternetGateway": "lab25-cloudwatch-igw",
